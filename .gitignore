# Public release allowlist. Local development files remain on disk, untracked.
/*
!/.gitignore
!/.gitattributes
!/LICENSE
!/LICENSE.meta
!/LICENSES/
!/LICENSES.meta
!/THIRD_PARTY_NOTICES.md
!/THIRD_PARTY_NOTICES.md.meta
!/README.md
!/README.md.meta
!/README.zh-CN.md
!/README.zh-CN.md.meta
!/manifest.xml
!/manifest.xml.meta
!/Shaders/
!/Shaders.meta
!/Material/
!/Material.meta
!/Prefab/
!/Prefab.meta
!/Runtime/
!/Runtime.meta
!/Tooltips/
!/Tooltips.meta
!/Documents/
!/Documents.meta
!/docs/
!/docs.meta
/Documents/*
!/Documents/Development.md
!/Documents/Development.md.meta
!/Documents/ReleaseNotes.*.md
!/Documents/ReleaseNotes.*.md.meta
!/Documents/TomShadersX-UserManual.*.md
!/Documents/TomShadersX-UserManual.*.md.meta
!/Documents/RenderDocs/
!/Documents/RenderDocs.meta
/Documents/RenderDocs/*
!/Documents/RenderDocs/*.md
!/Documents/RenderDocs/*.md.meta
!/Documents/RenderDocs/ShaderCatalog.json
