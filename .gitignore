# Public release allowlist. Local development files remain on disk, untracked.
/*
!/.gitignore
!/.gitattributes
!/LICENSE
!/LICENSE.meta
!/LICENSES/
!/LICENSES.meta
!/THIRD_PARTY_NOTICES.md
!/THIRD_PARTY_NOTICES.md.meta
!/README.md
!/README.md.meta
!/README.zh-CN.md
!/README.zh-CN.md.meta
!/manifest.xml
!/manifest.xml.meta
!/Shaders/
!/Shaders.meta
!/Material/
!/Material.meta
!/Prefab/
!/Prefab.meta
!/Runtime/
!/Runtime.meta
!/Tooltips/
!/Tooltips.meta
!/Documents/
!/Documents.meta
!/docs/
!/docs.meta
/Documents/*
!/Documents/Development.md
!/Documents/Development.md.meta
!/Documents/TomShadersX-UserManual.*.md
!/Documents/TomShadersX-UserManual.*.md.meta
/docs/*
!/docs/.nojekyll
!/docs/index.html
!/docs/Gallery*.html
!/docs/UserManual*.html
!/docs/*.html.meta
!/docs/*.png
!/docs/*.png.meta
!/docs/TomShadersX-UserManual.*.md
!/docs/TomShadersX-UserManual.*.md.meta
!/docs/Textures/
!/docs/Textures.meta
/Shaders/Tom/HiddenEyeStencilProbe.shader
/Shaders/Tom/HiddenEyeStencilProbe.shader.meta

# Never publish process output, even beneath a release directory.
**/AGENTS.md
**/AGENTS.md.meta
**/Tests/
**/Tests.meta
**/Evidence/
**/Evidence.meta
**/Cache/
**/Cache.meta
**/Logs/
**/Logs.meta
**/Temp/
**/Temp.meta
**/Library/
**/Library.meta
**/bin/
**/bin.meta
**/obj/
**/obj.meta
**/__pycache__/
**/.cache/
*.log.meta
*.tmp.meta
*.bak.meta
*.log
*.tmp
*.bak
*.csproj
*.sln
*.user
# Native release assets and their .meta files stay tracked.
/Library/
/Temp/
/Logs/
/Build/
/.vs/
/.idea/
*.csproj
*.sln
*.user
