!/docs/*.png
!/docs/*.png.meta
!/docs/TomShadersX-UserManual.*.md
!/docs/TomShadersX-UserManual.*.md.meta
!/docs/Textures/
!/docs/Textures.meta
/Shaders/Tom/HiddenEyeStencilProbe.shader
/Shaders/Tom/HiddenEyeStencilProbe.shader.meta

